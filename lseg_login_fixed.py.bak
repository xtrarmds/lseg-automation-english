from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.wait import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.keys import Keys
from selenium.common.exceptions import TimeoutException, NoSuchElementException

class LSEGLoginAutomationFixed:
    def __init__(self):
        # 登录凭证
        self.username = "ian.zhu@lseg.com"
        self.password = "Welcome802"
        self.headless = False
        self.timeout = 30
        
        # 文件路径配置
        self.downloads_path = Path("C:/Users/jacky/Downloads")
        self.target_dir = Path("c:/ric_change")
        self.target_file = "DownloadRicChangeEvents.xlsx"
        
        # SFTP配置
        self.sftp_host = "192.168.0.117"
        self.sftp_username = "ian"
        self.sftp_password = "3000xtra"
        self.sftp_remote_dir = "/home/ian/ricchange"
        
        # 邮件配置
        self.email_recipient = "ian.zhu@lseg.com"
        
        self.driver = None
        self.wait = None

    def run_with_retry_fixed(self, max_retries=1, retry_delay=300):
        """
        修正版运行程序，明确的退出机制
        max_retries: 最大重试次数（默认1次，避免无限循环）
        retry_delay: 重试间隔(秒)
        """
        print("🚀 开始LSEG自动下载和文件处理程序（修正版）...")
        print(f"📋 配置信息:")
        print(f"   - 最大重试次数: {max_retries}")
        print(f"   - 重试间隔: {retry_delay//60} 分钟")
        
        success_flag = False
        
        for attempt in range(max_retries):
            print(f"\n📍 第 {attempt + 1} 次尝试 (共 {max_retries} 次)")
            
            try:
                # 设置浏览器驱动
                self.setup_driver()
                
                # 执行登录
                if self.login():
                    print("✅ 登录和页面导航成功")
                    
                    # 等待下载完成
                    print("⏳ 等待文件下载完成...")
                    time.sleep(15)
                    
                    # 处理下载的文件
                    if self.process_downloaded_file():
                        print("🎉 完整程序执行成功！")
                        success_flag = True
                        break  # 成功后立即退出循环
                    else:
                        print("❌ 文件处理或上传失败")
                else:
                    print("❌ 登录或页面导航失败")
                    
            except Exception as e:
                print(f"❌ 程序执行出错: {e}")
            
            finally:
                # 每次尝试后都关闭浏览器
                self.cleanup_browser()
            
            # 如果不是最后一次尝试且未成功，等待后重试
            if not success_flag and attempt < max_retries - 1:
                print(f"⏳ {retry_delay//60} 分钟后重试...")
                # 发送重试通知邮件
                self.send_simple_report(f"第 {attempt + 1} 次尝试失败，将在 {retry_delay//60} 分钟后重试")
                time.sleep(retry_delay)
        
        # 最终结果处理
        if success_flag:
            print("\n🎉 程序执行成功完成！")
            self.send_simple_report("程序执行成功")
        else:
            print(f"\n❌ 程序执行失败，已尝试 {max_retries} 次")
            self.send_simple_report(f"程序执行失败，已尝试 {max_retries} 次")
        
        return success_flag

    def setup_driver(self):
        """配置浏览器驱动（简化版）"""
        if self.driver:  # 如果已经有driver，先关闭
            self.cleanup_browser()
            
        chrome_options = Options()
        # 基本的Chrome选项
        chrome_options.add_argument("--disable-notifications")
        chrome_options.add_argument("--disable-infobars")
        chrome_options.add_argument("--no-first-run")
        chrome_options.add_argument("--disable-extensions")
        
        print("🚀 正在启动Chrome浏览器...")
        
        # 设置ChromeDriver服务
        driver_path = "./drivers/chromedriver.exe"
        if os.path.exists(driver_path):
            service = Service(driver_path)
            self.driver = webdriver.Chrome(service=service, options=chrome_options)
            print("✅ Chrome浏览器启动成功")
        else:
            self.driver = webdriver.Chrome(options=chrome_options)
            print("✅ Chrome浏览器启动成功（自动驱动）")
        
        self.wait = WebDriverWait(self.driver, self.timeout)

    def login(self):
        """登录流程"""
        try:
            # 访问目标网站
            print("📍 访问LSEG网站...")
            self.driver.get("https://myaccount.lseg.com/en/symbolchanges")
            time.sleep(5)
            
            # 简化的登录步骤
            print("👤 输入登录信息...")
            username_field = self.wait.until(EC.presence_of_element_located((By.ID, "AAA-AS-SI1-SE003")))
            username_field.send_keys(self.username)
            
            password_field = self.wait.until(EC.presence_of_element_located((By.ID, "AAA-AS-SI1-SE007")))
            password_field.send_keys(self.password)
            password_field.send_keys(Keys.RETURN)
            
            time.sleep(5)
            print("✅ 登录步骤完成")
            return True
            
        except Exception as e:
            print(f"❌ 登录失败: {e}")
            return False

    def process_downloaded_file(self):
        """简化的文件处理"""
        print("📁 检查下载文件...")
        
        source_file = self.downloads_path / self.target_file
        if source_file.exists():
            print(f"✅ 找到文件: {source_file}")
            return True
        else:
            print(f"❌ 未找到文件: {source_file}")
            return False

    def send_simple_report(self, message):
        """发送简单报告"""
        print(f"📧 报告: {message}")

    def cleanup_browser(self):
        """清理浏览器资源"""
        try:
            if self.driver:
                self.driver.quit()
                print("🔚 浏览器已关闭")
        except Exception as e:
            print(f"⚠️ 关闭浏览器时出错: {e}")
        finally:
            self.driver = None
            self.wait = None

def main():
    """主函数"""
    print("🎯 LSEG自动化程序（修正版）")
    print("=" * 50)
    
    automation = LSEGLoginAutomationFixed()
    
    try:
        # 只尝试1次，避免无限循环
        success = automation.run_with_retry_fixed(max_retries=1, retry_delay=300)
        
        if success:
            print("\n🎉 程序执行成功！")
        else:
            print("\n❌ 程序执行失败！")
    
    except KeyboardInterrupt:
        print("\n⚠️ 程序被用户中断")
    
    except Exception as e:
        print(f"\n❌ 程序发生错误: {e}")
    
    finally:
        # 最终清理
        try:
            automation.cleanup_browser()
        except:
            pass
        
        print("\n🏁 程序即将退出...")
        print("=" * 50)
        
        # 强制退出
        print("✅ 程序已完全退出")
        sys.exit(0)

if __name__ == "__main__":
    main() 