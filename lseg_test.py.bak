        self.driver = None
        self.wait = None
    
    def test_existing_file(self):
        """测试处理现有文件"""
        print("🧪 测试模式：处理现有下载文件")
        
        # 检查是否有现有文件
        source_file = self.downloads_path / self.target_file
        if source_file.exists():
            print(f"✅ 找到现有文件: {source_file}")
            
            # 确保目标目录存在
            if not self.target_dir.exists():
                self.target_dir.mkdir(parents=True, exist_ok=True)
                print(f"✅ 创建目录: {self.target_dir}")
            
            # 处理Excel文件
            try:
                print(f"📊 开始处理Excel文件: {source_file}")
                
                # 读取Excel文件
                df = pd.read_excel(source_file)
                print(f"📋 文件包含 {len(df)} 行数据")
                print(f"📋 列名: {list(df.columns)}")
                
                if len(df.columns) >= 5:
                    # 获取E列（Country列）
                    country_column = df.iloc[:, 4]
                    column_name = df.columns[4]
                    print(f"📍 正在筛选 {column_name} 列中包含 'AU' 的数据...")
                    
                    # 显示E列的样本数据
                    print(f"📄 E列样本数据: {country_column.head().tolist()}")
                    
                    # 筛选包含AU的行
                    au_mask = country_column.astype(str).str.contains('AU', na=False, case=False)
                    au_data = df[au_mask].copy()
                    
                    print(f"✅ 筛选出 {len(au_data)} 条包含AU的记录")
                    
                    if len(au_data) > 0:
                        # 生成带日期的文件名
                        today = datetime.now().strftime("%Y%m%d")
                        new_filename = f"AU_RicChangeEvents_{today}.xlsx"
                        new_file_path = self.target_dir / new_filename
                        
                        # 保存筛选后的数据
                        au_data.to_excel(new_file_path, index=False)
                        print(f"✅ 已保存AU数据到: {new_file_path}")
                        print(f"📊 文件包含表头 + {len(au_data)} 条AU记录")
                        
                        # 测试SFTP上传
                        self.test_sftp_upload(new_file_path)
                        
                        # 生成邮件报告
                        self.send_test_report(True, new_file_path, len(au_data))
                        
                        return True
                    else:
                        print("⚠️ 没有找到包含AU的数据")
                        return False
                else:
                    print("❌ 文件列数不足，无法找到E列")
                    return False
                    
            except Exception as e:
                print(f"❌ 处理Excel文件时出错: {e}")
                return False
        else:
            print(f"❌ 未找到文件: {source_file}")
            return False
    
    def test_sftp_upload(self, local_file_path):
        """测试SFTP上传"""
        print(f"\n📤 测试SFTP上传: {local_file_path}")
        
        try:
            # 创建SSH客户端
            ssh = paramiko.SSHClient()
            ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            
            # 连接到服务器
            print(f"🔗 连接到 {self.sftp_host}...")
            ssh.connect(
                hostname=self.sftp_host,
                username=self.sftp_username,
                password=self.sftp_password,
                timeout=30
            )
            
            # 创建SFTP客户端
            sftp = ssh.open_sftp()
            
            # 确保远程目录存在
            try:
                remote_files = sftp.listdir(self.sftp_remote_dir)
                print(f"📁 远程目录现有文件: {remote_files}")
            except IOError:
                print(f"📁 创建远程目录: {self.sftp_remote_dir}")
                ssh.exec_command(f"mkdir -p {self.sftp_remote_dir}")
            
            # 上传文件
            remote_file_path = f"{self.sftp_remote_dir}/{local_file_path.name}"
            print(f"⬆️ 上传文件到: {remote_file_path}")
            sftp.put(str(local_file_path), remote_file_path)
            
            # 验证上传
            remote_files_after = sftp.listdir(self.sftp_remote_dir)
            if local_file_path.name in remote_files_after:
                print(f"✅ 文件上传成功")
                
                # 检查文件大小
                remote_stat = sftp.stat(remote_file_path)
                local_size = local_file_path.stat().st_size
                print(f"📏 本地文件大小: {local_size} 字节")
                print(f"📏 远程文件大小: {remote_stat.st_size} 字节")
                
                if remote_stat.st_size == local_size:
                    print("✅ 文件大小验证通过")
                    sftp.close()
                    ssh.close()
                    return True
                else:
                    print("❌ 文件大小不匹配")
            else:
                print("❌ 文件上传失败")
            
            sftp.close()
            ssh.close()
            return False
            
        except Exception as e:
            print(f"❌ SFTP上传失败: {e}")
            return False
    
    def send_test_report(self, success, file_path, au_count):
        """发送测试报告"""
        print("\n📧 生成测试报告...")
        
        if success:
            report = f"""
📋 RIC变更数据处理测试报告

✅ 测试状态: 成功
⏰ 测试时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
📁 处理文件: {file_path.name if file_path else 'N/A'}
📊 AU记录数量: {au_count}

测试结果:
- Excel文件读取: ✅ 成功
- AU数据筛选: ✅ 成功 (找到 {au_count} 条记录)
- 文件保存: ✅ 成功
- SFTP上传测试: ✅ 成功

文件位置:
- 本地: {file_path}
- 远程: {self.sftp_host}:{self.sftp_remote_dir}/{file_path.name}

收件人: {self.email_recipient}
---
测试完成
            """
        else:
            report = f"""
📋 RIC变更数据处理测试报告

❌ 测试状态: 失败
⏰ 测试时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

测试结果:
- 文件检查: ❌ 失败
- 建议: 请确保 {self.downloads_path / self.target_file} 文件存在

收件人: {self.email_recipient}
---
测试失败
            """
        
        print("=" * 60)
        print(report)
        print("=" * 60)

def main():
    """测试主函数"""
    test = LSEGTestAutomation()
    test.test_existing_file()

if __name__ == "__main__":
    main() 