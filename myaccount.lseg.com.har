\">\n            <h1 class=\"ui-heading--lg ui-heading--lg--medium\">\n                <span class=\"user-profile-title\">\n                    \t\t\t\t\t\t\n\t\t\t\t\t\t\t<span id=\"titleFname\"></span>\t\t<span id=\"titleLname\"></span>\n\t\t\t\t\t\t\n                    \n                </span>\n                \n                    <span id=\"title\">\n                         Instrument Change\n                        \n                    </span>\n                \n                \n                <span id=\"withdrawn-title\" style=\"display:none\">\n                    Notification withdrawn\n                </span>\n                <span id=\"cancelled-title\" style=\"display:none\">\n                    Notification cancelled\n                </span>\n            </h1>\n\n\n            <div class=\"displayTitle\">\n                <span class=\"ui-tooltip-icon toggle-button\">\n                    \n                </span>\n            </div>\n\n            \n        </div>\n        <div class=\"ui-header__duration\">\n            <p class=\"ui-heading--sm ui-heading--sm--medium ui-margin--none\"></p>\n        </div>\n        <div class=\"ui-header_title\">\n            \n                <div class=\"ui-header__description\">\n                    <span id=\"subtitle\">To access the latest update for the instrument changes, please accept the  Terms of Use.</span>\n                    <span id=\"description\"></span>\n                </div>\n            \n        </div>\n    </div>\n    <p class=\"hide\" id=\"hrefurl\">.html</P>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  \n<script>\n    var url = window.location.href;\n\n    if (url.indexOf('/dashboard') != -1) {\n        $('#dashborad-title').show();\n        $('#title').hide();\n    }\n    if (url.indexOf('/product/') != -1) {\n        $('#product-breadccrumb').show();\n        $('#breadcrumb').hide();\n        $('#subtitle').hide();\n        $('#description').show();\n    }\n    if (url.indexOf('/capability-finder/view-accounts') != -1) {\n\n        const queryParams = new URLSearchParams(window.location.search);\n        var title = queryParams.get(\"capabilityName\")\n        var subtitle = queryParams.get(\"capabilityVariantType\")\n\n        if(title != null && subtitle != null) {\n            $('.ui-header__title .ui-heading--lg #title').html(title);\n            $('#withdrawn-breadccrumb').show();\n            $('#withdrawn-breadccrumb').addClass(\"ui-color__text--grey-dark\");\n            $('#withdrawn-breadccrumb').addClass(\"withdrawn-breadccrumb-margin\");\n            $('#withdrawn-breadccrumb').removeClass(\"ui-color__text--complementary2\");\n            $('.ui-header__title').addClass(\"ui-margin--top--none\");\n            $('#withdrawn-breadccrumb').html(subtitle);\n        }\n\n    }\n    if (ContextHub.getItem(\"userData\")) {\n        var userDataDetails = ContextHub.getItem(\"userData\").userProfile.userInfo;\n        $('#titleFname').text(userDataDetails.address.firstName);\n        $('#titleLname').text(userDataDetails.address.lastName);\n    }\n</script></div>\n\n\n\n            </div>\t\t\t\n            <div>\n\n\n\n\n</div>\n            <div class=\"ui-app__content\">\n\t\t\t\n\n                \n\n\n\n\n\n    \n    \n    <div class=\"policyoverview\">\n    \n<link rel=\"stylesheet\" href=\"/etc.clientlibs/myrefinitiv/components/common/content/policiesresources-gcss/policyoverview/policyoverview.min.e2cd7b6226d64e2bf38ff73ac8f17c71.css\" type=\"text/css\">\n<script src=\"/etc.clientlibs/myrefinitiv/components/common/content/policiesresources-gcss/policyoverview/policyoverview.min.js\"></script>\n\n\n\n<script>\n\tvar description = \"\";\n    if(description!=\"\"){\n\t\t$('.ui-header__description #description').append(description);\n\t\t$('.ui-header__description #description').show();\n    }\n</script>\n<div class=\"ui-row\">\n   <div class=\"ui-col ui-col--2-3 quarterlynotification-description\">\n\t\t<div>\n\n\n\n\n</div>\n      \n         <div class=\"ui-row ui-row--no-gutters\" id=\"policy-carousel\">\n            <div class=\"ui-col ui-color__bg--white\">\n               <div class=\"policies-slide\">\n                  <div id=\"myCarousel\" class=\"carousel slide\" data-interval=\"false\"> \n                     \n                     \n                                    \n                                    \n                                    <a class=\"headLeft left carousel-control hidden\" href=\"#myCarousel\" data-slide=\"prev\">\n                                        <i class=\"ui-icon ui-icon--arrow-left ui-icon--medium ui-margin--bottom--none\"></i>\n                                    </a>\n                                    <a class=\"headRight right carousel-control hidden\" href=\"#myCarousel\" data-slide=\"next\">\n                                        <i class=\"ui-icon ui-icon--arrow-right ui-icon--medium ui-margin--bottom--none\"></i>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n        \n        <div class=\"ui-list\">\n            <div class=\"ui-row\">\n                <div class=\"ui-col\">\n                    <div class=\"paragraph m\">\n                        \n\t\t\t\t\t\t<div>\n\n\n\n\n    \n    \n    <div class=\"richtext\">\n<div class=\"content-bg\">\n    <div class=\"with-myrefinitiv\">\n        <div class=\"row\">\n            <div class=\"col-xs-12\">\n                <div class=\"faqtext\"><p>Access to and use of Instrument Changes is intended for customers’ own internal use only and is subject to the terms and conditions of your agreement with Refinitiv. In particular:</p>\n<p><b>(i)</b> You can only use any Refinitiv proprietary information accessible on My Refinitiv which is relevant to the service(s) you subscribe to, and in the ordinary course of using and operating the service you subscribe to as per that agreement;</p>\n<p><b>(ii)</b> Unless formally authorised by Refinitiv, you cannot share this information with any third party externally; and</p>\n<p><b>(iii)</b> If you operate a business which competes with Refinitiv, in no circumstances can you use Instrument Changes in your competing business, including for the purpose of gathering competitive intelligence, validation, verification or improving your competing products, datasets or databases.</p>\n</div>\n            </div>\n        </div>\n    </div>\n</div></div>\n\n\n</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\t\t<div class=\"ui-margin--top--lg\">\n\t\t\t<div>\n\n\n\n\n</div>\n        </div>\n\n    </div>\n    <div class=\"ui-col ui-col--1-3 \">\n        <div>\n\n\n\n\n</div>\n        <div>\n\n\n\n\n    \n    \n    <div class=\"instrumentchange-terms-of-use\">\n    \n    \n<link rel=\"stylesheet\" href=\"/etc.clientlibs/myrefinitiv/components/common/content/ric/instrumentchange-terms-of-use/clientlibs.min.46470ac37f8c57628e385db9761b8f2c.css\" type=\"text/css\">\n\n\n\n\n\n<input type=\"hidden\" id=\"einvoicingtitle\"/>\n\n<!-- right side component for checkbox -->\n<div class=\"ui-margin--bottom--md similar\">\n            <div class=\"ui-list\">\n    <div class=\"ui-list__title\">Accept to continue</div>\n        <div class=\"checkbox-component\">\n            <div class=\"ui-checkbox ui-checkbox--box\">\n                 <label class=\"ui-text__size--medium\"><span>\n                    I have read and agree to the <strong>Terms of Use</strong> </span>\n                     <input type=\"checkbox\" id=\"instrumentChangeCheck\" onchange=\"checkValueInstrument()\" name=\"a\"/><span class=\"ui-checkbox__bg\"></span>\n                  </label>\n                  <div id=\"error-terms-message\" class=\"ui-form__message hidden\"> Please read through entire Terms of Use.</div>\n                  <div id=\"error-terms-message1\" class=\"ui-form__message hidden\">Please select Terms of Use. </div>\n            </div>\n            <div class=\"in-btn-grp\">\n            <button id=\"instrumentchange\" type=\"button\" class=\"ui-btn ui-btn--primary track-custom-clicks\" data-link-type=\"CTA Click\" data-link-text=\"Accept and continue CTA\" data-asset-title=\"Button with Primary Style | Accept and continue\" disabled><span>Accept and Continue</span></button>\n            </div>\n        \n        </div>\n</div>\n</div>\n\n    \n    \n<script src=\"/etc.clientlibs/myrefinitiv/components/common/content/ric/instrumentchange-terms-of-use/clientlibs.min.js\"></script>\n\n\n\n</div>\n\n\n</div>\n    </div>\n    <!-- /#bottom-page-content-wrapper -->\n    <!-- /#footer-page-content-wrapper -->\n</div>\n<p id=\"carouselimages\" class=\"hidden\">[]</p>\n<p id=\"carouselvideos\" class=\"hidden\">[]</p>\n<p id=\"carouselcheckboxflag\" class=\"hidden\"></p></div>\n\n\n\n            </div>\n\n        </div>\n    </div>\n</div>\n<div id=\"global-footer-region\" class=\"global-footer-region\">\n    \n    \n\n\n\n\n    \n        \n        \n        <div class=\"newpar new section\">\n\n</div>\n\n    \n        \n        \n        <div class=\"par iparys_inherited\">\n\n    \n    \n    \n    \n        \n        \n        <div class=\"experiencefragment\">\n<div id=\"experiencefragment-005e9d98c0\" class=\"cmp-experiencefragment cmp-experiencefragment--site-footer-experience-fragment\">\r\n\n    \n\n\n\r\n<div class=\"xf-content-height\">\r\n    \n\n\n<div class=\"aem-Grid aem-Grid--12 aem-Grid--default--12 \">\n    \n    \n\n    \n    \n\n\n\n    \n    \n    \n    \n        \n    \n    \n    \n        \n\n    \n    \n    \n\n\n    \n\n    \n\n    \n\n    \n    \n\n    \n    \n    \n    \n\t\n    \n    \n\t\n    \n    \n    \n\t\n    <div data-react-from-markup-container=\"true\">\n        <div class=\"SiteFooter\" data-rehydratable=\"SiteFooter\" data-search-form-action=\"https://myaccount.lseg.com/en/searchpage\" data-clear-search-label=\"Clear search