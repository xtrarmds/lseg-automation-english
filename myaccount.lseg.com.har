\"/>\n                        </div>\n                    </a>\n                    <button aria-expanded=\"false\" aria-haspopup=\"true\" class=\"GlobalFooter-button\">\n                            <span class=\"GlobalFooter-caret\">\n                                \n    \n    \n    \n    \n    \n    <span class=\"Svg\">\n        <span class=\"Svg-inner\"><svg aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\"><path d=\"M16 10l-4 4-4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"square\" stroke-width=\"2\"></path></svg></span>\n    </span>\n    \n\n                            </span>\n                    </button>\n                </div>\n                <nav>\n                    <div data-rehydratable-children=\"true\" class=\"GlobalFooter-items\">\n                             \n                                <li class=\"GlobalFooterItem\">\n                                 \n                                  \n                                    <a class=\"GlobalFooterItem-inner\" href=\"https://www.lseg.com/en/policies/privacy-statement\">Privacy Statement</a>\n                                  \n                                </li>\n                            \n                                <li class=\"GlobalFooterItem\">\n                                 \n                                    <a class=\"GlobalFooterItem-inner ot-sdk-show-settings\" href=\"javascript:void(0)\">Cookie Settings</a>\n                                  \n                                  \n                                </li>\n                            \n                                <li class=\"GlobalFooterItem\">\n                                 \n                                  \n                                    <a class=\"GlobalFooterItem-inner\" href=\"https://www.lseg.com/en/policies/website-disclaimer\">Terms of Use</a>\n                                  \n                                </li>\n                            \n                                <li class=\"GlobalFooterItem\">\n                                 \n                                  \n                                    <a class=\"GlobalFooterItem-inner\" href=\"https://www.lseg.com/en/policies/website-disclaimer\">Copyright</a>\n                                  \n                                </li>\n                            \n                                <li class=\"GlobalFooterItem\">\n                                 \n                                  \n                                    <a class=\"GlobalFooterItem-inner\" href=\"https://privacyportalde-cdn.onetrust.com/dsarwebform/5f7a2da0-bed0-45e8-ac2c-c1f297e2efdc/1234b4c9-a981-4092-b398-cb80005998cf.html\">Do not sell my info</a>\n                                  \n                                </li>\n                            \n                    </div>\n                </nav>\n            </div>\n        </div>\n    </div>\n\n\n\n    \n    \n\n    \n    \n\n    \n</div>\n\r\n</div></div>\n\n    \n</div>\n\n    \n\n</div>\n\n    \n\n\n</div>\n        <div class=\"ui-app__sticky\">\n            <div data-tooltip=\"foo\"></div>\n        </div>\n\n\n    \n    \n<script src=\"/etc/designs/refinitiv-common/refinitiv-commons-gcss-clientlibs.min.js\"></script>\n\n\n\n\n<script>\n\t//added for setting limit to 15 of the component groups to be displayed in sidekick\n    var prodTitle = 'Instrument Change \\u002D Terms of Use';\n\t\n\t// Added code as per MYA-20638\n\tvar switchJaEn = \"Switching from JA to EN\";\n    var switchZhJa = \"Switching from ZH to JA\";\n    var switchEnJa = \"Switching from EN to JA\";\n    var switchJaZh = \"Switching from JA to ZH\";\n    var switchEnZh = \"Switching from EN to ZH\";\n    var switchZhEn = \"Switching from ZH to EN\";\n    var enText = \"EN\";\n    var zhText = \"中文\";\n    var jaText = \"日本\";\n\n\tvar userData = ContextHub.getItem(\"userData\");\n\tif(userData != null && userData != undefined && userData.userProfile != null){\n\n\t\tvar userPreferredLanguageParam = userData.userProfile.userInfo.language;\n\t\tvar switchedLang = rootNode;\n\t\t\n\t\tvar switchCondition = userPreferredLanguageParam != null;\n\n\t\tif(switchCondition){\n\t\t\tif(userPreferredLanguageParam == 'ja'){\n\t\t\t\tif(rootNode == 'ja'){\n\t\t\t\t\tswitchedLang = \"en\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchJaEn);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"englishlanguage\");\n\t\t\t\t\t$('#siteText').text(enText);\n\t\t\t\t}\n\t\t\t\telse if(rootNode == 'zh'){\n\t\t\t\t\tswitchedLang = \"ja\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchZhJa);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"chineselanguage\");\n\t\t\t\t\t$('#siteText').text(jaText);\n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\tswitchedLang = \"ja\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchEnJa);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"chineselanguage\");\n\t\t\t\t\t$('#siteText').text(jaText);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\telse if(userPreferredLanguageParam == 'zh_CN'){\n\t\t\t\tif(rootNode == 'ja'){\n\t\t\t\t\tswitchedLang = \"zh\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchJaZh);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"chineselanguage\");\n\t\t\t\t\t$('#siteText').text(zhText);\n\t\t\t\t}\n\t\t\t\telse if(rootNode == 'en'){\n\t\t\t\t\tswitchedLang = \"zh\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchEnZh);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"chineselanguage\");\n\t\t\t\t\t$('#siteText').text(zhText);\n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\tswitchedLang = \"en\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchZhEn);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"englishlanguage\");\n\t\t\t\t\t$('#siteText').text(enText);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\telse{\n\t\t\t\tif(rootNode == 'ja'){\n\t\t\t\t\tswitchedLang = \"en\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchJaEn);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"englishlanguage\");\n\t\t\t\t\t$('#siteText').text(enText);\n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\tswitchedLang = \"en\";\n\t\t\t\t\t$('#changeURL').attr(\"data-asset-title\", switchZhEn);\n\t\t\t\t\t$('#changeURL').attr(\"class\", \"englishlanguage\");\n\t\t\t\t\t$('#siteText').text(enText);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t}\n\t\t\n\t}\n\t//End of adding code for MYA-20638\n    function changeSite(oldLocale, newLocale) {\n        eraseCookie('language');\n        if (null != newLocale && newLocale == 'en')\n            createCookie('language', 'en-us', 1);\n        else\n            createCookie('language', 'zh-cn', 1);\n        var newURL = window.location.href.replace(\"/\" + oldLocale + \"/\", \"/\" + newLocale + \"/\");\n        var searchFlag = newURL.match(\"sp_k\");\n        var dnFlag = newURL.match(\"ZHS\");\n        if (searchFlag == \"sp_k\") {\n            switch (newLocale) {\n                case \"en\":\n                    newURL = newURL.replace(\"mytr-china\", \"mytr-english\").replace(\"searchLanguage=zh-cn\", \"searchLanguage=en-us\");\n                    break;\n                case \"zh\":\n                    newURL = newURL.replace(\"mytr-english\", \"mytr-china\").replace(\"searchLanguage=en-us\", \"searchLanguage=zh-cn\");\n                    break;\n                default:\n                    break;\n            }\n        }\n        if (dnFlag == \"ZHS\") {\n            newURL = newURL.replace('/ZHS', '');\n        }\n\n        window.location = encodeURI(newURL);\n        location.replace(encodeURI(newURL));\n\n    }\n\n    window.refinitiv_ui_plugins.DeviceDetection();\n    window.refinitiv_ui_plugins.InputPassword();\n    window.refinitiv_ui_plugins.GlobalHeader();\n    window.refinitiv_ui_plugins.Dialog();\n    window.refinitiv_ui_plugins.Modal();\n    window.refinitiv_ui_plugins.Popover();\n    window.refinitiv_ui_plugins.Tooltip();\n    window.refinitiv_ui_plugins.Tabs();\n    window.refinitiv_ui_plugins.Textarea();\n    window.refinitiv_ui_plugins.Accordion();\n\t//As Dropdown component getting some console errors.keeping the component at the end.\n\twindow.refinitiv_ui_plugins.Dropdown();\n</script>\n<script src=\"https://cdnapisec.kaltura.com/p/2479521/sp/247952100/embedIframeJs/uiconf_id/50591492/partner_id/2479521\"></script>\n<script>\n    _babelPolyfill = false;\n</script>\n<script src=\"/etc/designs/forge-ui/versions/forge-ui-v5-1-0/main.js\"></script>\n<script>\n    _babelPolyfill = false;\n</script>\n \n\n    \n\n\n\n    <div>\n</div>\n    <div>\n        \n    \n<script src=\"/etc.clientlibs/refinitiv-common/components/content/structure/base-page/redirect-clientlibs.min.js\"></script>\n\n\n\n    </div>\n\n\t\n        \n    \n<script src=\"/etc/designs/myrefinitiv/globalClientLibsFooter.min.js\"></script>\n\n\n\n    \n</body>\n</html>"
