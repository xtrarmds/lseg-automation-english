            "text": "/*!\n * Refinitiv UI Style Guide\n * ------------------------\n * styles/main-1.16.1.css\n * f00abd99847754c62fbb\n * Mon Aug 12 2019 16:13:10 GMT+0000 (Coordinated Universal Time)\n *//*! normalize.css v3.0.3 | MIT License | github.com/necolas/normalize.css */html{font-family:sans-serif;-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}\nbody{margin:0}\narticle,aside,details,figcaption,figure,footer,header,hgroup,main,menu,nav,section,summary{display:block}\naudio,canvas,progress,video{display:inline-block;vertical-align:baseline}\naudio:not([controls]){display:none;height:0}\n[hidden],template{display:none}\na{background-color:transparent}\na:active,a:hover{outline:0}\nabbr[title]{border-bottom:1px dotted}\nb,strong{font-weight:bold}\ndfn{font-style:italic}\nh1{font-size:2em;margin:.67em 0}\nmark{background:#ff0;color:#000}\nsmall{font-size:80%}\nsub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline}\nsup{top:-0.5em}\nsub{bottom:-0.25em}\nimg{border:0}\nsvg:not(:root){overflow:hidden}\nfigure{margin:1em 40px}\nhr{-webkit-box-sizing:content-box;box-sizing:content-box;height:0}\npre{overflow:auto}\nbutton,input,optgroup,select,textarea{color:inherit;font:inherit;margin:0}\nbutton{overflow:visible}\nbutton,select{text-transform:none}\nbutton,html input[type=\"button\"],input[type=\"reset\"],input[type=\"submit\"]{-webkit-appearance:button;cursor:pointer}\nbutton[disabled],html input[disabled]{cursor:default}\nbutton::-moz-focus-inner,input::-moz-focus-inner{border:0;padding:0}\ninput{line-height:normal}\ninput[type=\"checkbox\"],input[type=\"radio\"]{-webkit-box-sizing:border-box;box-sizing:border-box;padding:0}\ninput[type=\"number\"]::-webkit-inner-spin-button,input[type=\"number\"]::-webkit-outer-spin-button{height:auto}\ninput[type=\"search\"]{-webkit-appearance:textfield;-webkit-box-sizing:content-box;box-sizing:content-box}\ninput[type=\"search\"]::-webkit-search-cancel-button,input[type=\"search\"]::-webkit-search-decoration{-webkit-appearance:none}\nfieldset{border:1px solid silver;margin:0 2px;padding:.35em .625em .75em}\nlegend{border:0;padding:0}\ntextarea{overflow:auto}\noptgroup{font-weight:bold}\ntable{border-collapse:collapse;border-spacing:0}\ntd,th{padding:0}\n.ui-color__text--white{color:white !important}\n.ui-color__text--primary{color:#001eff !important}\n.ui-color__text--primary-dark{color:#001add !important}\n.ui-color__text--primary-darker{color:#0013a1 !important}\n.ui-color__text--accent1{color:#ff5000 !important}\n.ui-color__text--accent1-dark{color:#dc4500 !important}\n.ui-color__text--accent1-darker{color:#993500 !important}\n.ui-color__text--accent2{color:#d0d3d4 !important}\n.ui-color__text--complementary1{color:#00d0d4 !important}\n.ui-color__text--complementary1-dark{color:#0a8285 !important}\n.ui-color__text--complementary2{color:#dc0a0a !important}\n.ui-color__text--complementary2-dark{color:#a00000 !important}\n.ui-color__text--complementary3{color:#498502 !important}\n.ui-color__text--complementary3-dark{color:#387c2b !important}\n.ui-color__text--complementary4{color:#6e3ab7 !important}\n.ui-color__text--complementary4-dark{color:#621f95 !important}\n.ui-color__text--complementary5{color:#ffc800 !important}\n.ui-color__text--grey-darkest{color:#262626 !important}\n.ui-color__text--grey-darker{color:#3d3d3d !important}\n.ui-color__text--grey-dark{color:#4d4d4d !important}\n.ui-color__text--grey{color:#666 !important}\n.ui-color__text--grey-light{color:#afafaf !important}\n.ui-color__text--grey-muted{color:#ddd !important}\n.ui-color__text--grey-lighter{color:#eaeaea !important}\n.ui-color__text--grey-lightest{color:#f4f4f4 !important}\n.ui-color__bg--white{background-color:white !important}\n.ui-color__bg--primary{background-color:#001eff !important}\n.ui-color__bg--primary-dark{background-color:#001add !important}\n.ui-color__bg--primary-darker{background-color:#0013a1 !important}\n.ui-color__bg--accent1{background-color:#ff5000 !important}\n.ui-color__bg--accent1-dark{background-color:#dc4500 !important}\n.ui-color__bg--accent1-darker{background-color:#993500 !important}\n.ui-color__bg--accent2{background-color:#d0d3d4 !important}\n.ui-color__bg--complementary1{background-color:#00d0d4 !important}\n.ui-color__bg--complementary1-dark{background-color:#0a8285 !important}\n.ui-color__bg--complementary2{background-color:#dc0a0a !important}\n.ui-color__bg--complementary2-dark{background-color:#a00000 !important}\n.ui-color__bg--complementary3{background-color:#498502 !important}\n.ui-color__bg--complementary3-dark{background-color:#387c2b !important}\n.ui-color__bg--complementary4{background-color:#6e3ab7 !important}\n.ui-color__bg--complementary4-dark{background-color:#621f95 !important}\n.ui-color__bg--complementary5{background-color:#ffc800 !important}\n.ui-color__bg--grey-darkest{background-color:#262626 !important}\n.ui-color__bg--grey-darker{background-color:#3d3d3d !important}\n.ui-color__bg--grey-dark{background-color:#4d4d4d !important}\n.ui-color__bg--grey{background-color:#666 !important}\n.ui-color__bg--grey-light{background-color:#afafaf !important}\n.ui-color__bg--grey-muted{background-color:#ddd !important}\n.ui-color__bg--grey-lighter{background-color:#eaeaea !important}\n.ui-color__bg--grey-lightest{background-color:#f4f4f4 !important}\n[class*=\"ui-color__flag--\"]{position:relative}\n[class*=\"ui-color__flag--\"]:before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;z-index:1}\n.ui-color__flag--primary:before{background-color:#001eff !important}\n.ui-color__flag--primary-dark:before{background-color:#001add !important}\n.ui-color__flag--primary-darker:before{background-color:#0013a1 !important}\n.ui-color__flag--accent1:before{background-color:#ff5000 !important}\n.ui-color__flag--accent1-dark:before{background-color:#dc4500 !important}\n.ui-color__flag--accent1-darker:before{background-color:#993500 !important}\n.ui-color__flag--accent2:before{background-color:#d0d3d4 !important}\n.ui-color__flag--complementary1:before{background-color:#00d0d4 !important}\n.ui-color__flag--complementary1-dark:before{background-color:#0a8285 !important}\n.ui-color__flag--complementary2:before{background-color:#dc0a0a !important}\n.ui-color__flag--complementary2-dark:before{background-color:#a00000 !important}\n.ui-color__flag--complementary3:before{background-color:#498502 !important}\n.ui-color__flag--complementary3-dark:before{background-color:#387c2b !important}\n.ui-color__flag--complementary4:before{background-color:#6e3ab7 !important}\n.ui-color__flag--complementary4-dark:before{background-color:#621f95 !important}\n.ui-color__flag--complementary5:before{background-color:#ffc800 !important}\n.ui-color__flag--grey-darkest:before{background-color:#262626 !important}\n.ui-color__flag--grey-darker:before{background-color:#3d3d3d !important}\n.ui-color__flag--grey-dark:before{background-color:#4d4d4d !important}\n.ui-color__flag--grey:before{background-color:#666 !important}\n.ui-color__flag--grey-light:before{background-color:#afafaf !important}\n.ui-color__flag--grey-muted:before{background-color:#ddd !important}\n.ui-color__flag--grey-lighter:before{background-color:#eaeaea !important}\n.ui-color__flag--grey-lightest:before{background-color:#f4f4f4 !important}\n#user-management tbody tr .actions-cell a:hover{text-decoration:underline}\n#calendar_task_management .column-control-calendar .grid-item a:hover{text-decoration:underline}\n#byfiltering .column-control .datepicker tbody button{line-height:inherit}\n.ui-icon{display:inline-block;font-size:20px;width:1em;height:1em;line-height:1;vertical-align:middle;margin-top:-2.5px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}\n.ui-icon.ui-icon--activity-log{background:transparent url(\"data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20height='20'%20width='20'%20viewBox='0,0,20,20'%3E%3Cg%20fill='none'%20fill-rule='evenodd'%20stroke='%234d4d4d'%20stroke-width='1.2