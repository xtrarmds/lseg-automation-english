            "mimeType": "text/css",
            "text": ".policyoverview .training-carousel #trainingCarousel{padding-top:30px;padding-bottom:30px}\n.policyoverview .training-carousel #trainingCarousel h3{margin-top:0}\n.ui-header__description #description{display:none}\n.quarterlynotification-description .faqtext{background-color:#f4f4f4;padding:40px;margin:20px 0 0}\n.carousel-control{position:absolute;top:0;bottom:0;left:0;width:15%;font-size:20px;color:#fff;text-align:center;text-shadow:0 1px 2px rgba(0,0,0,.6);background-color:rgba(0,0,0,0);filter:alpha(opacity=50);opacity:.5}\n.carousel-control.left{position:relative;margin-left:26%;margin-top:20px;float:left;background:0;color:#4d4d4d}\n.carousel-control.right{position:relative;float:right;margin-right:26%;margin-top:20px;background:0;color:#4d4d4d}\n.carousel-indicators{bottom:-40px;height:6px}\n.carousel-indicators li{background:silver;width:8px !important;height:8px !important}\n.tab-container-gcss .rte{padding:0 40px 40px}\n.carousel-indicators .active{background:#333;margin:1px}\n.carousel-inner .item-width{min-height:446px}\n.carousel-inner .video-content{position:absolute;bottom:60px}\n.carousel-inner video,.carousel-inner img{width:100%;height:100%;vertical-align:top;object-fit:fill}\n.carousel-inner .heading-alignment{word-wrap:break-word}\n.ui-content-card__body{z-index:auto}\n.video-content{z-index:1}\n.policies-slide .ui-content-card__image::before{background:transparent;content:none}\n.carousel-inner>.active{display:block}\n.carousel-inner .ui-content-card{display:block}\n.ui-list.gray-bg{background-color:transparent;padding-left:0;padding-right:0;padding-top:0}\n@media screen and (max-width:1259px){.policyoverview .training-carousel #trainingCarousel{padding-top:10px}\n.carousel-inner .item-width{min-height:426px}\n}\n@media screen and (max-width:719px){.quarterlynotification-description .faqtext{padding:30px}\n.ui-list.gray-bg{padding-left:20px;padding-right:20px}\n#product-carousel .carousel-inner .item-width,#policy-carousel .carousel-inner .item-width{min-height:initial}\n#product-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image,#policy-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image{padding-top:80% !important;position:absolute;min-height:initial}\n#product-carousel .carousel-inner video,#product-carousel .carousel-inner img,#policy-carousel .carousel-inner video,#policy-carousel .carousel-inner img{position:absolute;top:0;right:0;left:0;bottom:0}\n#product-carousel .carousel-inner .ui-content-card,#policy-carousel .carousel-inner .ui-content-card{height:0;padding-top:80% !important}\n}\n@media screen and (max-width:580px){#product-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image,#product-carousel .carousel-inner .ui-content-card,#policy-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image,#policy-carousel .carousel-inner .ui-content-card{padding-top:57% !important}\n}\n@media screen and (max-width:375px){#product-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image,#product-carousel .carousel-inner .ui-content-card,#policy-carousel .ui-content-card--horizontal:not(.ui-content-card--split) .ui-content-card__image,#policy-carousel .carousel-inner .ui-content-card{padding-top:88% !important}\n}\n#CQ .x-html-editor-tb .x-edit-addcolor{background:url(policyoverview/css/color_wheel.png) center no-repeat}"
