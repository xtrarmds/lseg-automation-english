import os
import time
import platform
import zipfile
import urllib.request
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.chrome.options import Options
from selenium.common.exceptions import TimeoutException, NoSuchElementException
from selenium.webdriver.chrome.service import Service
import subprocess
import sys

def download_chromedriver():
    """下载适合当前系统的chromedriver"""
    system = platform.system()
    if system == "Windows":
        driver_url = "https://chromedriver.storage.googleapis.com/114.0.5735.90/chromedriver_win32.zip"
        driver_name = "chromedriver.exe"
    elif system == "Darwin":  # macOS
        driver_url = "https://chromedriver.storage.googleapis.com/114.0.5735.90/chromedriver_mac64.zip"
        driver_name = "chromedriver"
    else:  # Linux
        driver_url = "https://chromedriver.storage.googleapis.com/114.0.5735.90/chromedriver_linux64.zip"
        driver_name = "chromedriver"
    
    driver_dir = os.path.join(os.getcwd(), "drivers")
    os.makedirs(driver_dir, exist_ok=True)
    driver_path = os.path.join(driver_dir, driver_name)
    
    if os.path.exists(driver_path):
        return driver_path
    
    print(f"📥 正在下载 chromedriver...")
    zip_path = os.path.join(driver_dir, "chromedriver.zip")
    
    try:
        urllib.request.urlretrieve(driver_url, zip_path)
        
        with zipfile.ZipFile(zip_path, 'r') as zip_ref:
            zip_ref.extractall(driver_dir)
        
        os.remove(zip_path)
        
        if system != "Windows":
            os.chmod(driver_path, 0o755)
        
        print(f"✅ chromedriver 下载完成: {driver_path}")
        return driver_path
        
    except Exception as e:
        print(f"❌ 下载 chromedriver 失败: {e}")
        return None

class LSEGLoginAutomation:
    def __init__(self):
        # 直接在代码中配置凭证（因为.env文件无法创建）
        self.username = "ian.zhu@lseg.com"
        self.password = "Welcome802"
        self.headless = False
        self.timeout = 30
        
        self.driver = None
        self.wait = None
        
    def setup_driver(self):
        """配置浏览器驱动，禁用密码保存"""
        chrome_options = Options()
        
        # 禁用密码保存和自动填充
        chrome_options.add_argument("--disable-password-manager-reauthentication")
        chrome_options.add_argument("--disable-save-password-bubble")
        chrome_options.add_argument("--disable-password-generation")
        chrome_options.add_argument("--disable-autofill")
        chrome_options.add_argument("--disable-autofill-keyboard-accessory-view")
        chrome_options.add_argument("--disable-full-form-autofill-ios")
        
        # 添加用户首选项禁用密码保存
        prefs = {
            "credentials_enable_service": False,
            "profile.password_manager_enabled": False,
            "profile.default_content_setting_values.notifications": 2,
            "profile.default_content_settings.popups": 0,
        }
        chrome_options.add_experimental_option("prefs", prefs)
        
        # 其他设置
        chrome_options.add_argument("--disable-blink-features=AutomationControlled")
        chrome_options.add_experimental_option("excludeSwitches", ["enable-automation"])
        chrome_options.add_experimental_option('useAutomationExtension', False)
        
        # 窗口大小设置（根据录制的尺寸）
        chrome_options.add_argument("--window-size=1051,805")
        
        if self.headless:
            chrome_options.add_argument("--headless")
            
        # 设置下载目录
        download_dir = os.path.abspath('./downloads')
        os.makedirs(download_dir, exist_ok=True)
        
        prefs["download.default_directory"] = download_dir
        chrome_options.add_experimental_option("prefs", prefs)
        
        # 创建驱动 - 尝试多种方式
        try:
            # 方法1: 使用系统PATH中的chromedriver
            self.driver = webdriver.Chrome(options=chrome_options)
        except Exception as e1:
            try:
                # 方法2: 使用默认的Chrome驱动位置
                service = Service()
                self.driver = webdriver.Chrome(service=service, options=chrome_options)
            except Exception as e2:
                try:
                    # 方法3: 下载chromedriver
                    print("🔄 尝试自动下载chromedriver...")
                    driver_path = download_chromedriver()
                    if driver_path:
                        service = Service(driver_path)
                        self.driver = webdriver.Chrome(service=service, options=chrome_options)
                    else:
                        raise Exception("下载chromedriver失败")
                except Exception as e3:
                    print(f"❌ 无法启动Chrome驱动: {e1}")
                    print(f"❌ 备用方法也失败: {e2}")
                    print(f"❌ 自动下载也失败: {e3}")
                    print("💡 请确保已安装Chrome浏览器，或手动下载chromedriver")
                    print("💡 下载地址: https://chromedriver.chromium.org/")
                    raise Exception("无法启动Chrome驱动，请检查Chrome浏览器和驱动安装")
        
        # 执行脚本来进一步禁用自动保存
        self.driver.execute_script("Object.defineProperty(navigator, 'webdriver', {get: () => undefined})")
        
        self.wait = WebDriverWait(self.driver, self.timeout)
        
    def login(self):
        """执行登录流程"""
        try:
            print("🚀 开始登录流程...")
            
            # 1. 访问目标网站（会自动跳转到登录页面）
            target_url = "https://myaccount.lseg.com/en/symbolchanges"
            print(f"📍 访问目标网站: {target_url}")
            self.driver.get(target_url)
            
            # 等待页面跳转到登录页面
            print("⏳ 等待跳转到登录页面...")
            time.sleep(3)
            
            # 2. 输入用户名
            print("👤 输入用户名...")
            username_field = self.wait.until(
                EC.presence_of_element_located((By.ID, "AAA-AS-SI1-SE003"))
            )
            username_field.clear()
            username_field.send_keys(self.username)
            
            # 3. 输入密码
            print("🔒 输入密码...")
            password_field = self.wait.until(
                EC.presence_of_element_located((By.ID, "AAA-AS-SI1-SE006"))
            )
            password_field.clear()
            password_field.send_keys(self.password)
            
            # 4. 点击复选框（可能是"记住我"或同意条款）
            print("☑️ 点击复选框...")
            try:
                checkbox = self.wait.until(
                    EC.element_to_be_clickable((By.CSS_SELECTOR, ".ui-checkbox__bg"))
                )
                checkbox.click()
            except TimeoutException:
                print("⚠️ 复选框未找到，继续下一步...")
            
            # 5. 点击 "Accept and Continue" 按钮
            print("✅ 点击 Accept and Continue...")
            accept_button = self.wait.until(
                EC.element_to_be_clickable((By.CSS_SELECTOR, "#instrumentchange > span"))
            )
            accept_button.click()
            
            # 6. 处理 Cookie 同意弹窗
            print("🍪 处理 Cookie 同意弹窗...")
            try:
                cookie_accept_button = self.wait.until(
                    EC.element_to_be_clickable((By.ID, "onetrust-accept-btn-handler"))
                )
                cookie_accept_button.click()
                print("✅ Cookie 弹窗已处理")
            except TimeoutException:
                print("⚠️ Cookie 弹窗未找到，可能已经处理过了...")
            
            # 7. 额外的导航步骤（基于录制）
            print("🧭 执行额外的导航步骤...")
            
            # 点击导航元素
            try:
                nav_element = self.wait.until(
                    EC.element_to_be_clickable((By.CSS_SELECTOR, ".sc-dNLxif path:nth-child(2)"))
                )
                nav_element.click()
                time.sleep(2)
            except TimeoutException:
                print("⚠️ 导航元素未找到，跳过...")
            
            # 点击列表元素
            try:
                list_element = self.wait.until(
                    EC.element_to_be_clickable((By.CSS_SELECTOR, ".riclist"))
                )
                list_element.click()
                time.sleep(2)
            except TimeoutException:
                print("⚠️ 列表元素未找到，跳过...")
            
            # 点击 Apply 按钮
            try:
                apply_button = self.wait.until(
                    EC.element_to_be_clickable((By.CSS_SELECTOR, ".sc-VJcYb"))
                )
                apply_button.click()
                print("✅ Apply 按钮已点击")
            except TimeoutException:
                print("⚠️ Apply 按钮未找到，跳过...")
            
            # 8. 等待登录完成
            print("⏳ 等待登录完成...")
            time.sleep(5)
            
            # 检查当前URL来验证登录状态
            current_url = self.driver.current_url
            print(f"🌐 当前页面URL: {current_url}")
            
            if "symbolchanges" in current_url or "myaccount.lseg.com" in current_url:
                print("🎉 登录成功！已到达 Symbol Changes 页面")
                return True
            else:
                print("❌ 登录可能失败，请检查页面状态")
                return False
                
        except TimeoutException as e:
            print(f"❌ 登录超时: {e}")
            return False
        except Exception as e:
            print(f"❌ 登录过程中发生错误: {e}")
            return False
    
    def get_page_info(self):
        """获取当前页面信息"""
        try:
            title = self.driver.title
            url = self.driver.current_url
            print(f"📄 页面标题: {title}")
            print(f"🌐 页面URL: {url}")
            
            # 尝试找到页面上的主要元素
            try:
                page_content = self.driver.find_element(By.TAG_NAME, "body")
                print("📝 页面内容已加载")
                
                # 查找可能的下载按钮
                download_buttons = self.driver.find_elements(By.XPATH, "//button[contains(text(), 'Download') or contains(text(), 'Export') or contains(text(), 'CSV') or contains(text(), 'Excel')]")
                if download_buttons:
                    print(f"📥 找到 {len(download_buttons)} 个可能的下载按钮")
                    for i, btn in enumerate(download_buttons):
                        print(f"  {i+1}. {btn.text}")
                else:
                    print("🔍 未找到明显的下载按钮")
                    
                # 查找所有按钮元素
                all_buttons = self.driver.find_elements(By.TAG_NAME, "button")
                if all_buttons:
                    print(f"🔘 页面上共有 {len(all_buttons)} 个按钮")
                    for i, btn in enumerate(all_buttons[:10]):  # 只显示前10个
                        try:
                            btn_text = btn.text.strip()
                            if btn_text:
                                print(f"  {i+1}. '{btn_text}'")
                        except:
                            pass
                    
            except NoSuchElementException:
                print("⚠️ 页面内容加载异常")
                
        except Exception as e:
            print(f"❌ 获取页面信息时发生错误: {e}")
    
    def close(self):
        """关闭浏览器"""
        if self.driver:
            print("🔚 关闭浏览器...")
            self.driver.quit()

def main():
    """主函数"""
    automation = LSEGLoginAutomation()
    
    try:
        # 设置浏览器
        automation.setup_driver()
        
        # 执行登录
        login_success = automation.login()
        
        if login_success:
            print("\n" + "="*50)
            print("🎉 登录成功完成！")
            print("="*50)
            
            # 获取页面信息
            automation.get_page_info()
            
            # 保持浏览器打开一段时间以便观察
            print("\n🔍 浏览器将保持打开状态 30 秒，以便您观察页面...")
            time.sleep(30)
            
        else:
            print("\n❌ 登录失败，请检查凭证和网络连接")
            
    except Exception as e:
        print(f"❌ 程序执行过程中发生错误: {e}")
        
    finally:
        # 清理资源
        automation.close()

if __name__ == "__main__":
    main() 